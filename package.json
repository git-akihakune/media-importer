    "esbuild": "^0.20.0",
    "eslint": "^8.57.0",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "dependencies": {
    "minio": "^8.0.0"
  }
